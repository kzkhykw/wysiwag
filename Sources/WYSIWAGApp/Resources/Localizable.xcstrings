{
  "sourceLanguage": "en",
  "strings": {
    "A local-first, open-source screen-to-table recorder for macOS. Your CSV is the source of truth.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A local-first, open-source screen-to-table recorder for macOS. Your CSV is the source of truth."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面を表に記録する、macOS向けオープンソースアプリ。ローカルのCSVを正本として保存します。"
          }
        }
      }
    },
    "A plain table of what was on screen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A plain table of what was on screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面に表示された内容を、シンプルな表に。"
