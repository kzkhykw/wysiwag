    "ALL saves every capture. AUTO detects changes locally. SMART asks Jev on every capture.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ALL saves every capture. AUTO detects changes locally. SMART asks Jev on every capture."
